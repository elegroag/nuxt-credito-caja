{
  "name": "nuxt-creditos",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:pull": "prisma db pull",
    "db:migrate": "prisma migrate dev --schema=./prisma/schema.prisma",
    "db:reset": "prisma migrate reset --schema=./prisma/schema.prisma",
    "db:seed": "prisma db seed",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:unit": "vitest run",
    "test:unit:server": "vitest run --project server-unit",
    "test:unit:client": "vitest run --project client-unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:coverage": "vitest run --coverage",
    "nohup:firmas": "tsx server/nohup/app.ts",
    "nohup:firmas:daemon": "nohup pnpm nohup:firmas >> storage/logs/nohup-firmas.log 2>&1 &"
  },
  "dependencies": {
    "@heroicons/vue": "^2.2.0",
    "@iconify-json/lucide": "^1.2.121",
    "@iconify-json/simple-icons": "^1.2.93",
    "@lucide/vue": "^1.28.0",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/icon": "^2.4.1",
    "@nuxt/image": "2.0.0",
    "@nuxt/ui": "^4.10.0",
    "@prisma/adapter-mariadb": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@vee-validate/nuxt": "4.15.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "jose": "^6.2.8",
    "nodemailer": "^8.0.11",
    "nuxt": "^4.5.1",
    "nuxt-auth-utils": "^0.5.30",
    "qrcode": "^1.5.4",
    "radix-vue": "^1.9.17",
    "ssh2-sftp-client": "^12.1.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.16.0",
    "@nuxt/test-utils": "^4.1.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^25.9.5",
    "@types/nodemailer": "^8.0.1",
    "@types/ssh2-sftp-client": "^9.0.6",
    "@vee-validate/zod": "^4.15.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "autoprefixer": "^10.5.4",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^20.11.1",
    "msw": "^2.15.0",
    "prettier": "^3.9.6",
    "prisma": "^7.9.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.7",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  },
  "resolutions": {
    "unimport": "6.1.0"
  },
  "packageManager": "pnpm@11.9.0",
  "onlyBuiltDependencies": [
    "esbuild",
    "@parcel/watcher"
  ]
}
