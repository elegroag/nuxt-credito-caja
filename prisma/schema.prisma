generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "mysql"
}

model documentos_postulantes {
  id                  BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  username            String              @db.VarChar(100)
  tipo_documento      String              @db.VarChar(50)
  nombre_original     String              @db.VarChar(255)
  saved_filename      String              @db.VarChar(255)
  tipo_mime           String?             @db.VarChar(100)
  tamano_bytes        Int?
  ruta_archivo        String?             @db.VarChar(500)
  api_path            String?             @db.VarChar(500)
  api_filename        String?             @db.VarChar(255)
  solicitud_id        String              @db.VarChar(20)
  activo              Boolean             @default(true)
  created_at          DateTime?           @db.Timestamp(0)
  updated_at          DateTime?           @db.Timestamp(0)
  solicitudes_credito solicitudes_credito @relation(fields: [solicitud_id], references: [numero_solicitud], onDelete: Cascade, onUpdate: NoAction, map: "documentos_postulantes_solicitud_id_foreign")
  users               users               @relation(fields: [username], references: [username], onDelete: Cascade, onUpdate: NoAction, map: "documentos_postulantes_username_foreign")

  @@index([activo], map: "documentos_postulantes_activo_index")
  @@index([api_path], map: "documentos_postulantes_api_path_index")
  @@index([solicitud_id], map: "documentos_postulantes_solicitud_id_index")
  @@index([tipo_documento], map: "documentos_postulantes_tipo_documento_index")
  @@index([username], map: "documentos_postulantes_username_index")
}

model empresas_convenio {
  id                      BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  nit                     BigInt                   @unique(map: "empresas_convenio_nit_unique")
  razon_social            String                   @db.VarChar(255)
  fecha_convenio          DateTime?                @db.Date
  fecha_vencimiento       DateTime?                @db.Date
  estado                  empresas_convenio_estado @default(Activo)
  representante_documento String?                  @db.VarChar(20)
  representante_nombre    String?                  @db.VarChar(255)
  telefono                String?                  @db.VarChar(20)
  correo                  String?                  @db.VarChar(255)
  direccion               String?                  @db.Text
  ciudad                  String?                  @db.VarChar(100)
  departamento            String?                  @db.VarChar(100)
  sector_economico        String?                  @db.VarChar(100)
  numero_empleados        Int?
  tipo_empresa            String?                  @db.VarChar(100)
  descripcion             String?                  @db.Text
  notas_internas          String?                  @db.Text
  created_at              DateTime?                @db.Timestamp(0)
  updated_at              DateTime?                @db.Timestamp(0)

  @@index([estado], map: "empresas_convenio_estado_index")
  @@index([fecha_vencimiento], map: "empresas_convenio_fecha_vencimiento_index")
  @@index([nit], map: "empresas_convenio_nit_index")
}

model estados_solicitud {
  id                  String                @id @db.VarChar(50)
  nombre              String                @db.VarChar(100)
  descripcion         String?               @db.Text
  orden               Int
  color               String                @default("#6B7280") @db.VarChar(7)
  activo              Boolean               @default(true)
  created_at          DateTime?             @db.Timestamp(0)
  updated_at          DateTime?             @db.Timestamp(0)
  solicitud_timeline  solicitud_timeline[]
  solicitudes_credito solicitudes_credito[]

  @@index([activo], map: "estados_solicitud_activo_index")
  @@index([orden], map: "estados_solicitud_orden_index")
}

model firmantes_solicitud {
  id                  BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  solicitud_id        String              @db.VarChar(20)
  orden               Int
  tipo                String              @db.VarChar(50)
  nombre_completo     String              @db.VarChar(255)
  numero_documento    String              @db.VarChar(50)
  email               String              @db.VarChar(255)
  rol                 String              @db.VarChar(100)
  created_at          DateTime?           @db.Timestamp(0)
  updated_at          DateTime?           @db.Timestamp(0)
  telefono            String?             @db.VarChar(20)
  codigo_pais         String?             @db.VarChar(5)
  solicitudes_credito solicitudes_credito @relation(fields: [solicitud_id], references: [numero_solicitud], onDelete: Cascade, onUpdate: NoAction, map: "firmantes_solicitud_solicitud_id_foreign")

  @@unique([solicitud_id, orden], map: "unique_firmante_solicitud")
  @@index([email], map: "firmantes_solicitud_email_index")
  @@index([numero_documento], map: "firmantes_solicitud_numero_documento_index")
  @@index([solicitud_id], map: "firmantes_solicitud_solicitud_id_index")
}

model modules {
  id                   BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  parent_id            BigInt?   @db.UnsignedBigInt
  key                  String    @unique(map: "modules_key_unique") @db.VarChar(100)
  title                String    @db.VarChar(200)
  route_name           String?   @db.VarChar(200)
  href                 String?   @db.VarChar(500)
  icon                 String?   @db.VarChar(100)
  section              String    @default("General") @db.VarChar(100)
  ordering             Int       @default(0)
  active               String    @default("S") @db.Char(1)
  description          String?   @db.Text
  permissions_required Json?
  created_at           DateTime? @db.Timestamp(0)
  updated_at           DateTime? @db.Timestamp(0)
  modules              modules?  @relation("modulesTomodules", fields: [parent_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "modules_parent_id_foreign")
  other_modules        modules[] @relation("modulesTomodules")

  @@index([active, section, ordering], map: "modules_active_section_ordering_index")
  @@index([key], map: "modules_key_index")
  @@index([parent_id, ordering], map: "modules_parent_id_ordering_index")
}

model notifications {
  id              String    @id @db.Char(36)
  type            String    @db.VarChar(255)
  notifiable_type String    @db.VarChar(255)
  notifiable_id   String    @db.VarChar(255)
  data            Json
  read_at         DateTime? @db.Timestamp(0)
  created_at      DateTime? @db.Timestamp(0)
  updated_at      DateTime? @db.Timestamp(0)
  owner_username  String    @db.VarChar(100)
  users           users     @relation(fields: [owner_username], references: [username], onDelete: Cascade, onUpdate: NoAction, map: "notifications_user_username_foreign")

  @@index([created_at], map: "notifications_created_at_index")
  @@index([notifiable_type, notifiable_id], map: "notifications_notifiable_type_notifiable_id_index")
  @@index([read_at], map: "notifications_read_at_index")
  @@index([type], map: "notifications_type_index")
  @@index([owner_username], map: "notifications_username_index")
}

model numero_solicitudes {
  id                BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  radicado          String    @unique(map: "numero_solicitudes_radicado_unique") @db.VarChar(20)
  numeric_secuencia Int       @default(0)
  linea_credito     String    @default("03") @db.VarChar(10)
  vigencia          Int
  created_at        DateTime? @db.Timestamp(0)
  updated_at        DateTime? @db.Timestamp(0)

  @@index([linea_credito], map: "numero_solicitudes_linea_credito_index")
  @@index([numeric_secuencia], map: "numero_solicitudes_numeric_secuencia_index")
  @@index([vigencia], map: "numero_solicitudes_vigencia_index")
}

model pdfs_generados {
  id                  BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  solicitud_id        String              @unique(map: "pdfs_generados_solicitud_id_unique") @db.VarChar(20)
  path                String              @db.VarChar(500)
  filename            String              @db.VarChar(255)
  generado_en         Json?
  created_at          DateTime?           @db.Timestamp(0)
  updated_at          DateTime?           @db.Timestamp(0)
  solicitudes_credito solicitudes_credito @relation(fields: [solicitud_id], references: [numero_solicitud], onDelete: Cascade, onUpdate: NoAction, map: "pdfs_generados_solicitud_id_foreign")

  @@index([filename], map: "pdfs_generados_filename_index")
  @@index([solicitud_id], map: "pdfs_generados_solicitud_id_index")
}

model personal_access_tokens {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  tokenable_type String    @db.VarChar(255)
  tokenable_id   BigInt    @db.UnsignedBigInt
  name           String    @db.Text
  token          String    @unique(map: "personal_access_tokens_token_unique") @db.VarChar(64)
  abilities      String?   @db.Text
  last_used_at   DateTime? @db.Timestamp(0)
  expires_at     DateTime? @db.Timestamp(0)
  created_at     DateTime? @db.Timestamp(0)
  updated_at     DateTime? @db.Timestamp(0)

  @@index([expires_at], map: "personal_access_tokens_expires_at_index")
  @@index([tokenable_type, tokenable_id], map: "personal_access_tokens_tokenable_type_tokenable_id_index")
}

model roles {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  nombre      String    @unique(map: "roles_nombre_unique") @db.VarChar(50)
  descripcion String?   @db.VarChar(255)
  permisos    Json?
  color       String    @default("#6B7280") @db.VarChar(7)
  orden       Int       @default(0)
  activo      Boolean   @default(true)
  created_at  DateTime? @db.Timestamp(0)
  updated_at  DateTime? @db.Timestamp(0)
  etiqueta    String?   @db.VarChar(45)

  @@index([activo], map: "roles_activo_index")
  @@index([nombre], map: "roles_nombre_index")
  @@index([orden], map: "roles_orden_index")
}

model configurations {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  clave       String    @unique(map: "configurations_clave_unique") @db.VarChar(100)
  valor       String    @db.Text
  descripcion String?   @db.VarChar(255)
  tipo        String    @default("string") @db.VarChar(50)
  categoria   String    @default("general") @db.VarChar(100)
  editable    Boolean   @default(true)
  required    Boolean   @default(false)
  created_at  DateTime? @db.Timestamp(0)
  updated_at  DateTime? @db.Timestamp(0)

  @@index([categoria], map: "configurations_categoria_index")
  @@index([clave], map: "configurations_clave_index")
}

model sessions {
  id            String  @id @db.VarChar(255)
  user_id       BigInt? @db.UnsignedBigInt
  ip_address    String? @db.VarChar(45)
  user_agent    String? @db.Text
  payload       String  @db.LongText
  last_activity Int

  @@index([last_activity], map: "sessions_last_activity_index")
  @@index([user_id], map: "sessions_user_id_index")
}

model solicitud_documentos {
  id                     BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  solicitud_id           String              @db.VarChar(20)
  documento_uuid         String              @unique(map: "solicitud_documentos_documento_uuid_unique") @db.VarChar(36)
  documento_requerido_id String              @db.VarChar(100)
  nombre_original        String              @db.VarChar(255)
  saved_filename         String              @db.VarChar(255)
  tipo_mime              String?             @db.VarChar(100)
  tamano_bytes           Int?
  ruta_archivo           String?             @db.VarChar(500)
  activo                 Boolean             @default(true)
  created_at             DateTime?           @db.Timestamp(0)
  updated_at             DateTime?           @db.Timestamp(0)
  deleted_at             DateTime?           @db.Timestamp(0)
  solicitudes_credito    solicitudes_credito @relation(fields: [solicitud_id], references: [numero_solicitud], onDelete: Cascade, onUpdate: NoAction, map: "solicitud_documentos_solicitud_id_foreign")

  @@index([activo], map: "solicitud_documentos_activo_index")
  @@index([documento_requerido_id], map: "solicitud_documentos_documento_requerido_id_index")
  @@index([solicitud_id], map: "solicitud_documentos_solicitud_id_index")
}

model solicitud_payload {
  id                    BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  solicitud_id          String              @db.VarChar(20)
  version               String              @default("1.0") @db.VarChar(20)
  informacion_laboral   Json?
  ingresos_descuentos   Json?
  informacion_economica Json?
  propiedades           Json?
  deudas                Json?
  referencias           Json?
  linea_credito         Json?
  created_at            DateTime?           @db.Timestamp(0)
  updated_at            DateTime?           @db.Timestamp(0)
  solicitudes_credito   solicitudes_credito @relation(fields: [solicitud_id], references: [numero_solicitud], onDelete: Cascade, onUpdate: NoAction, map: "solicitud_payload_solicitud_id_foreign")

  @@unique([solicitud_id, version], map: "solicitud_payload_solicitud_id_version_unique")
  @@index([solicitud_id], map: "solicitud_payload_solicitud_id_index")
}

model solicitud_solicitante {
  id                       BigInt                             @id @default(autoincrement()) @db.UnsignedBigInt
  solicitud_id             String                             @db.VarChar(20)
  tipo_persona             solicitud_solicitante_tipo_persona @default(natural)
  tipo_documento           String                             @db.VarChar(3)
  numero_documento         String                             @db.VarChar(20)
  nombres                  String?                            @db.VarChar(100)
  apellidos                String?                            @db.VarChar(100)
  razon_social             String?                            @db.VarChar(200)
  nit                      String?                            @db.VarChar(20)
  fecha_nacimiento         DateTime?                          @db.Date
  pais_nacimiento          String?                            @db.Char(3)
  fecha_expedicion         DateTime?                          @db.Date
  genero                   solicitud_solicitante_genero?
  estado_civil             String?                            @db.VarChar(20)
  nivel_educativo          String?                            @db.VarChar(50)
  profesion                String?                            @db.VarChar(100)
  email                    String?                            @db.VarChar(150)
  telefono_fijo            String?                            @db.Char(10)
  telefono_movil           String?                            @db.Char(10)
  direccion                String?                            @db.VarChar(200)
  barrio                   String?                            @db.VarChar(100)
  ciudad                   String?                            @db.VarChar(100)
  pais_residencia          String?                            @db.Char(3)
  tipo_vivienda            String?                            @db.Char(2)
  vive_con_nucleo_familiar Boolean                            @default(false)
  personas_a_cargo         Int                                @default(0) @db.SmallInt
  departamento             String?                            @db.VarChar(100)
  codigo_categoria         String?                            @db.VarChar(1)
  cargo                    String?                            @db.VarChar(100)
  salario                  Decimal?                           @db.Decimal(15, 2)
  antiguedad_meses         Int?
  tipo_contrato            String?                            @db.VarChar(50)
  sector_economico         String?                            @db.VarChar(100)
  created_at               DateTime?                          @db.Timestamp(0)
  updated_at               DateTime?                          @db.Timestamp(0)
  solicitudes_credito      solicitudes_credito                @relation(fields: [solicitud_id], references: [numero_solicitud], onDelete: Cascade, onUpdate: NoAction, map: "solicitud_solicitante_solicitud_id_foreign")

  @@index([nit], map: "solicitud_solicitante_nit_index")
  @@index([numero_documento], map: "solicitud_solicitante_numero_documento_index")
  @@index([solicitud_id], map: "solicitud_solicitante_solicitud_id_index")
  @@index([tipo_documento], map: "solicitud_solicitante_tipo_documento_index")
}

model solicitud_timeline {
  id                  BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  solicitud_id        String              @db.VarChar(20)
  estado              String              @db.VarChar(50)
  fecha               DateTime            @default(now()) @db.Timestamp(0)
  detalle             String?             @db.Text
  usuario_username    String?             @db.VarChar(100)
  automatico          Boolean             @default(false)
  created_at          DateTime?           @db.Timestamp(0)
  updated_at          DateTime?           @db.Timestamp(0)
  estados_solicitud   estados_solicitud   @relation(fields: [estado], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "solicitud_timeline_estado_foreign")
  solicitudes_credito solicitudes_credito @relation(fields: [solicitud_id], references: [numero_solicitud], onDelete: Cascade, onUpdate: NoAction, map: "solicitud_timeline_solicitud_id_foreign")
  users               users?              @relation(fields: [usuario_username], references: [username], onUpdate: NoAction, map: "solicitud_timeline_usuario_username_foreign")

  @@index([estado], map: "solicitud_timeline_estado_index")
  @@index([fecha], map: "solicitud_timeline_fecha_index")
  @@index([solicitud_id], map: "solicitud_timeline_solicitud_id_index")
  @@index([usuario_username], map: "solicitud_timeline_usuario_username_index")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model solicitudes_credito {
  numero_solicitud       String                   @id @db.VarChar(20)
  owner_username         String                   @db.VarChar(100)
  valor_solicitud        Decimal                  @db.Decimal(15, 2)
  plazo_meses            Int
  tasa_interes           Decimal                  @db.Decimal(5, 2)
  estado                 String                   @db.VarChar(50)
  pdf_generado           Json?
  fecha_radicado         DateTime?                @db.Date
  producto_tipo          String?                  @db.Char(2)
  ha_tenido_credito      Boolean                  @default(false)
  detalle_modalidad      String?                  @db.VarChar(255)
  tipo_credito           String?                  @db.Char(3)
  moneda                 String                   @default("COP") @db.Char(3)
  cuota_mensual          Decimal?                 @db.Decimal(12, 2)
  created_at             DateTime?                @db.Timestamp(0)
  updated_at             DateTime?                @db.Timestamp(0)
  rol_en_solicitud       rol_en_solicitud         @default(T)
  numero_comprobante     String?                  @db.VarChar(20)
  documentos_postulantes documentos_postulantes[]
  firmantes_solicitud    firmantes_solicitud[]
  pdfs_generados         pdfs_generados?
  solicitud_documentos   solicitud_documentos[]
  solicitud_payload      solicitud_payload[]
  solicitud_solicitante  solicitud_solicitante[]
  solicitud_timeline     solicitud_timeline[]
  estados_solicitud      estados_solicitud        @relation(fields: [estado], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "solicitudes_credito_estado_foreign")
  users                  users                    @relation(fields: [owner_username], references: [username], onDelete: Cascade, onUpdate: NoAction, map: "solicitudes_credito_owner_username_foreign")

  @@index([created_at], map: "solicitudes_credito_created_at_index")
  @@index([estado], map: "solicitudes_credito_estado_index")
  @@index([owner_username], map: "solicitudes_credito_owner_username_index")
}

model tipo_documentos {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  tipo       String    @unique(map: "tipo_documentos_tipo_unique") @db.VarChar(50)
  detalle    String    @db.VarChar(100)
  orden      Int       @db.SmallInt
  activo     Boolean   @default(true)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)

  @@index([activo], map: "tipo_documentos_activo_index")
  @@index([orden], map: "tipo_documentos_orden_index")
  @@index([tipo], map: "tipo_documentos_tipo_index")
}

model users {
  id                     BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  username               String                   @unique(map: "users_username_unique") @db.VarChar(100)
  email                  String                   @unique(map: "users_email_unique") @db.VarChar(255)
  full_name              String?                  @db.VarChar(255)
  phone                  String?                  @db.VarChar(20)
  roles                  Json?
  disabled               Boolean                  @default(false)
  is_active              Boolean                  @default(true)
  tipo_documento         String?                  @db.VarChar(3)
  numero_documento       String?                  @db.VarChar(20)
  nombres                String?                  @db.VarChar(100)
  apellidos              String?                  @db.VarChar(100)
  password_hash          String                   @db.VarChar(255)
  last_login             DateTime?                @db.Timestamp(0)
  email_verified_at      DateTime?                @db.Timestamp(0)
  remember_token         String?                  @db.VarChar(100)
  created_at             DateTime?                @db.Timestamp(0)
  updated_at             DateTime?                @db.Timestamp(0)
  pin_verification       String?                  @db.VarChar(4)
  documentos_postulantes documentos_postulantes[]
  notifications          notifications[]
  solicitud_timeline     solicitud_timeline[]
  solicitudes_credito    solicitudes_credito[]

  @@index([disabled], map: "users_disabled_index")
  @@index([email], map: "users_email_index")
  @@index([is_active], map: "users_is_active_index")
  @@index([last_login], map: "users_last_login_index")
  @@index([numero_documento], map: "users_numero_documento_index")
  @@index([username], map: "users_username_index")
}

enum solicitud_solicitante_tipo_persona {
  natural
  juridica
}

enum empresas_convenio_estado {
  Activo
  Inactivo
  Suspendido
  Vencido
}

enum solicitud_solicitante_genero {
  M
  F
  O
}

enum rol_en_solicitud {
  T
  S
  C
  E
}
