# =============================================================================
# Plantilla de variables de entorno — Comfaca Créditos (Nuxt)
# Copiar a www/.env y completar. En Docker, www/.env se usa en el build y al ejecutar:
# tras cualquier cambio ejecutar `docker compose up -d --build`.
# Las variables marcadas [secreto] no deben versionarse.
# =============================================================================

# -----------------------------------------------------------------------------
# Aplicación
# -----------------------------------------------------------------------------
# Etapa de la app. Con un valor distinto de "prod" algunos errores devuelven el stack trace.
# Valores: dev | prod
STAGE=dev
# Modo de ejecución de Node. En producción debe ser "production".
# Valores: development | test | production
NODE_ENV=development
# Sin uso: nuxt.config.ts fija el preset "node-server".
NITRO_PRESET='node'

# Puerto del servidor de desarrollo (`pnpm dev`). En Docker el puerto es NITRO_PORT=4000 (Dockerfile).
NUXT_PORT=4000
# Host del servidor de desarrollo (`pnpm dev`). Usar "0.0.0.0" para exponerlo en la red local.
NUXT_HOST="localhost"
# Sin uso en el código actual.
NUXT_ENV=dev
# Sin uso en el código actual.
NUXT_DOMAIN="localhost"
# Sin uso en el código actual.
NUXT_MODE=dev

# -----------------------------------------------------------------------------
# Base de datos (MySQL/MariaDB) — lib/prisma.ts y prisma.config.ts
# -----------------------------------------------------------------------------
# Conexión activa. "dev" usa DATABASE_URL_DEV; cualquier otro valor usa DATABASE_URL_PRO.
# Valores: dev | pro
DATABASE_ENV=dev
# [secreto] Cadena de conexión de producción: mysql://usuario:password@host:3306/base
DATABASE_URL_PRO="mysql://usuario:password@host:3306/nuxt_creditos"
# [secreto] Cadena de conexión de desarrollo. En Docker, "localhost" es el propio contenedor.
DATABASE_URL_DEV="mysql://usuario:password@localhost:3306/nuxt_creditos"
# [secreto] Clave de cifrado de la sesión (cookie) de nuxt-auth-utils. Mínimo 32 caracteres.
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NUXT_SESSION_PASSWORD=

# -----------------------------------------------------------------------------
# API SISU (datos de afiliados y trabajadores)
# -----------------------------------------------------------------------------
# Entorno: "pro" usa API_SISU_URL_PRO; cualquier otro valor usa API_SISU_URL_DEV.
# Valores: dev | pro
API_SISU_ENV=pro
# URL base de producción, incluye /api. Ej: https://comfacaenlinea.com.co:9000/api
API_SISU_URL_PRO="https://"
# URL base de desarrollo, incluye /api.
API_SISU_URL_DEV="http://"
# [secreto] Client ID para obtener el token (POST /token) cuando TYPE_AUTH=Bearer.
API_SISU_CLIENT_ID=""
# [secreto] Password asociado al client ID.
API_SISU_PASSWORD=""
# Esquema de autenticación. Valores: Basic | Bearer
API_SISU_TYPE_AUTH="Basic"
# [secreto] Usuario para autenticación Basic.
API_SISU_BASIC_USER=""
# [secreto] Password para autenticación Basic.
API_SISU_BASIC_PASSWORD=""

# -----------------------------------------------------------------------------
# API FirmaPlus (firma digital) — app y worker de firmas (server/nohup)
# -----------------------------------------------------------------------------
# Entorno: "pro" usa API_FIRMA_URL_PRO; cualquier otro valor usa API_FIRMA_URL_DEV.
# Valores: dev | pro
API_FIRMA_ENV=dev
# true: respuestas simuladas (MOCK) sin llamar a FirmaPlus. false: llamadas reales (envía correos a firmantes).
# Sin definir: simula solo si API_FIRMA_ENV=dev.
API_FIRMA_SIMULATION=true
# URL base de producción.
API_FIRMA_URL_PRO="https://firmaplus.co/Risk/api"
# URL base del entorno de pruebas de FirmaPlus.
API_FIRMA_URL_DEV="https://firmaplus.co/FirmaPlusPruebas/api"
# Esquema de autenticación. Valores: Basic | Bearer
API_FIRMA_TYPE_AUTH="Basic"
# [secreto] Usuario para autenticación Basic.
API_FIRMA_BASIC_USER=""
# [secreto] Password para autenticación Basic.
API_FIRMA_BASIC_PASSWORD=""
# [secreto] Client ID para obtener el token cuando TYPE_AUTH=Bearer.
API_FIRMA_CLIENT_ID=""
# [secreto] Password asociado al client ID.
API_FIRMA_PASSWORD=""
# [secreto] Clave AES-256-GCM para cifrar los tokens de los enlaces públicos de firma: 64 caracteres hex.
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_FIRMA_KEY=

# -----------------------------------------------------------------------------
# API Flask PDF (generación del formulario de solicitud en PDF)
# -----------------------------------------------------------------------------
# Entorno: "pro" usa API_FLASKPDF_URL_PRO; cualquier otro valor usa API_FLASKPDF_URL_DEV.
# Valores: dev | pro
API_FLASKPDF_ENV=dev
# URL base de producción, incluye /api. Ej: http://host:5000/api
API_FLASKPDF_URL_PRO="http://"
# URL base de desarrollo, incluye /api. Ej: http://localhost:5000/api
API_FLASKPDF_URL_DEV="http://localhost:5000/api"
# [secreto] Usuario de autenticación Basic de la API Flask.
API_FLASKPDF_USER=""
# [secreto] Password de autenticación Basic de la API Flask.
API_FLASKPDF_PASSWORD=""

# -----------------------------------------------------------------------------
# Backend y seguridad
# -----------------------------------------------------------------------------
# Puerto que se concatena a NUXT_BACKEND_BASE_URL en runtimeConfig.backendBaseUrl (sin uso actual en el servidor).
NUXT_BACKEND_BASE_PORT=5001
# URL base del backend (sin puerto) para runtimeConfig.backendBaseUrl (sin uso actual en el servidor).
NUXT_BACKEND_BASE_URL="http://localhost"
# [secreto] Clave para firmar y verificar los JWT de acceso (Bearer) de la API.
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NUXT_JWT_SECRET=

# -----------------------------------------------------------------------------
# Almacenamiento local (rutas relativas a www/ o absolutas)
# -----------------------------------------------------------------------------
# Carpeta de documentos y PDFs de las solicitudes.
STORAGE_DOCUMENTS_PATH="storage/documents/"
# Se carga en runtimeConfig pero el logger escribe siempre en storage/logs/app.log.
STORAGE_LOGS_PATH="storage/logs/"
# Se carga en runtimeConfig; sin uso actual en el código.
STORAGE_UPLOADS_PATH="storage/uploads/"
# Opcional. Carpeta temporal de reportes Excel. Por defecto: storage/temp
STORAGE_TEMP_PATH="storage/temp"

# Opcional. Nivel mínimo de log. Valores: DEBUG | INFO | WARN | ERROR (por defecto INFO)
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Correo (SMTP) — Gmail: usar App Password de 16 caracteres
# -----------------------------------------------------------------------------
# Etiqueta de entorno del correo; se carga en la configuración pero no cambia el envío.
MAIL_ENV=dev
# Servidor SMTP.
MAIL_HOST="smtp.gmail.com"
# Puerto SMTP: 465 (SSL) o 587 (STARTTLS).
MAIL_PORT=465
# true con el puerto 465 (SSL); false con el 587 (STARTTLS).
MAIL_SECURE=true
# [secreto] Usuario de la cuenta SMTP.
MAIL_USER=""
# [secreto] Password o App Password de la cuenta SMTP.
MAIL_PASSWORD=""
# Nombre del remitente.
MAIL_FROM_NAME="Comfaca Créditos"
# Correo del remitente. Si está vacío se usa MAIL_USER.
MAIL_FROM_ADDRESS=""
# Verificación del certificado TLS del servidor SMTP.
# NUNCA poner en "false" en producción. Solo para diagnóstico local.
MAIL_REJECT_UNAUTHORIZED=true

# -----------------------------------------------------------------------------
# SFTP — transferencia de archivos sobre SSH
# -----------------------------------------------------------------------------
# Etiqueta de entorno SFTP; se carga en la configuración pero no cambia la conexión.
SFTP_ENV=dev
# Host del servidor SFTP.
SFTP_HOST=""
# Puerto SSH del servidor SFTP.
SFTP_PORT=22
# [secreto] Usuario SFTP.
SFTP_USER=""
# [secreto] Password SFTP. Se ignora si se define SFTP_PRIVATE_KEY_BASE64.
SFTP_PASSWORD=""
# [secreto] Alternativa recomendada al password: clave privada codificada en base64.
SFTP_PRIVATE_KEY_BASE64=""
# [secreto] Passphrase de la clave privada, si la tiene.
SFTP_PASSPHRASE=""
# Ruta base remota; las operaciones usan rutas relativas a esta.
SFTP_BASE_PATH="/"
# Tiempo máximo en milisegundos para conectar y para cada operación.
SFTP_READY_TIMEOUT_MS=20000
